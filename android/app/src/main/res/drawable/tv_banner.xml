<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 Android TV launcher banner: app icon on the app's dark background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0B0D12"/>
            <size android:width="320dp" android:height="180dp"/>
        </shape>
    </item>
    <item android:gravity="center" android:width="120dp" android:height="120dp" android:drawable="@mipmap/ic_launcher"/>
</layer-list>
